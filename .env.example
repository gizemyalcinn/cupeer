APIFY_API_TOKEN=your_apify_api_token_here
GEMINI_API_KEY=your_gemini_api_key_here

# PostgreSQL bağlantı adresi (örn. Render Postgres veya yerel bir Postgres sunucusu)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Oturum çerezlerini imzalamak için rastgele, uzun bir metin (örn. `python -c "import secrets; print(secrets.token_hex(32))"`)
SESSION_SECRET_KEY=change_me_to_a_random_secret

# Google ile giriş için https://console.cloud.google.com adresinden alınır (opsiyonel — boş bırakılırsa Google girişi devre dışı kalır)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
